@model Showroom.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
    var bannerClass = Model.IsDatabaseConnected ? "status-success" : "status-warning";
    var isAdministrator = User.IsInRole(ShowroomRoles.Administrator);
    var hasSalesFilter = Model.SalesFrom is not null || Model.SalesTo is not null;
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Bảng điều khiển</span>
            <h1>Toan canh van hanh showroom</h1>
            <p>Theo dõi nhanh tồn kho, cơ cấu thương hiệu và hiệu quả bán hàng trong cùng một không gian.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" asp-controller="Orders" asp-action="Index">Quản lý đơn hàng</a>
            @if (isAdministrator)
            {
                <a class="btn btn-outline-secondary" asp-controller="Brands" asp-action="Index">Quản lý hãng xe</a>
                <a class="btn btn-outline-secondary" asp-controller="Cars" asp-action="Index">Quản lý xe</a>
                <a class="btn btn-outline-secondary" asp-controller="AuditLogs" asp-action="Index">Xem nhật ký</a>
            }
        </div>
    </div>

    <div class="status-banner @bannerClass">
        <strong>Trạng thái ket noi:</strong> @Model.StatusMessage
    </div>

    <article class="panel-card dashboard-filter-panel">
        <form method="get" asp-action="Index" class="dashboard-filter-form">
            <div class="dashboard-filter-copy">
                <h2 class="h4 mb-1">Lọc thống kê xe bán chạy</h2>
                <p class="table-note mb-0">Chọn khoảng ngày tạo đơn hàng để xem top xe bán chạy trong giai đoạn mong muốn.</p>
            </div>
            <div class="dashboard-filter-fields">
                <div>
                    <label class="form-label" for="salesFrom">Tu ngay</label>
                    <input class="form-control" id="salesFrom" name="salesFrom" type="date" value="@(Model.SalesFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div>
                    <label class="form-label" for="salesTo">Den ngay</label>
                    <input class="form-control" id="salesTo" name="salesTo" type="date" value="@(Model.SalesTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="dashboard-filter-actions">
                    <button type="submit" class="btn btn-primary">Áp dụng</button>
                    @if (hasSalesFilter)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
                    }
                </div>
            </div>
        </form>
    </article>

    <div class="metrics-grid">
        <article class="stat-card">
            <div class="stat-label">Tong so xe ton kho</div>
            <p class="stat-value">@Model.TotalCarsInStock</p>
        </article>
        <article class="stat-card">
            <div class="stat-label">Số hãng xe đang quản lý</div>
            <p class="stat-value">@Model.BrandInventory.Count</p>
        </article>
        <article class="stat-card">
            <div class="stat-label">Mẫu xe bán chạy đang hiển thị</div>
            <p class="stat-value">@Model.BestSellingCars.Count</p>
        </article>
    </div>

    <div class="dashboard-grid">
        <article class="panel-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Thống kê tồn kho theo hãng</h2>
                    <p class="table-note mb-0">Tong hop so luong xe hien con trong kho theo tung thuong hieu.</p>
                </div>
            </div>

            @if (Model.BrandInventory.Count == 0)
            {
                <p class="table-note mb-0">Hiện chưa có dữ liệu tồn kho theo hãng xe.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Hãng xe</th>
                                <th class="text-end">Số lượng tồn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BrandInventory)
                            {
                                <tr>
                                    <td>@item.BrandName</td>
                                    <td class="text-end">@item.StockQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <article class="panel-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">Thống kê xe bán chạy</h2>
                    <p class="table-note mb-0">
                        Các mẫu xe nổi bật dựa trên những đơn hàng đã hoàn tất, đã thanh toán hoặc đã giao xe.
                        @if (hasSalesFilter)
                        {
                            <span>Khoảng lọc hiện tại: @(Model.SalesFrom?.ToString("dd/MM/yyyy") ?? "tất cả") - @(Model.SalesTo?.ToString("dd/MM/yyyy") ?? "tất cả").</span>
                        }
                    </p>
                </div>
            </div>

            @if (Model.BestSellingCars.Count == 0)
            {
                <p class="table-note mb-0">Hiện chưa có dữ liệu thống kê bán hàng trong khoảng đã chọn.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Mẫu xe</th>
                                <th>Hãng xe</th>
                                <th class="text-end">Đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BestSellingCars)
                            {
                                <tr>
                                    <td>@item.CarName</td>
                                    <td>@item.BrandName</td>
                                    <td class="text-end">@item.SoldQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </div>
</section>
