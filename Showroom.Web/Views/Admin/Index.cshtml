@model Showroom.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Bang dieu khien";
    var bannerClass = Model.IsDatabaseConnected ? "status-success" : "status-warning";
    var isAdministrator = User.IsInRole(ShowroomRoles.Administrator);
    var hasSalesFilter = Model.SalesFrom is not null || Model.SalesTo is not null;
}

<section class="dashboard-shell dashboard-premium">
    <!-- ═══════ PAGE HEADING ═══════ -->
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:-2px"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Bang dieu khien
            </span>
            <h1 class="dash-title-gradient">Toan canh van hanh showroom</h1>
            <p class="dash-subtitle">Theo doi nhanh ton kho, co cau thuong hieu va hieu qua ban hang trong cung mot khong gian.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary btn-dash-action" asp-controller="Orders" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:-2px"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                Quan ly don hang
            </a>
            @if (isAdministrator)
            {
                <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Brands" asp-action="Index">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>
                    Quan ly hang xe
                </a>
                <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Cars" asp-action="Index">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Quan ly xe
                </a>
                <a class="btn btn-outline-secondary btn-dash-action" asp-controller="AuditLogs" asp-action="Index">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Xem nhat ky
                </a>
            }
        </div>
    </div>

    <!-- ═══════ STATUS BANNER ═══════ -->
    <div class="status-banner dash-status-banner @bannerClass">
        @if (Model.IsDatabaseConnected)
        {
            <span class="dash-status-icon dash-status-icon--ok">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
        }
        else
        {
            <span class="dash-status-icon dash-status-icon--warn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </span>
        }
        <strong>Trang thai ket noi:</strong> @Model.StatusMessage
    </div>

    <!-- ═══════ METRICS CARDS ═══════ -->
    <div class="metrics-grid dash-metrics-premium">
        <article class="stat-card dash-stat-card dash-stat-card--inventory">
            <div class="dash-stat-card__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </div>
            <div class="dash-stat-card__content">
                <div class="stat-label">Tong so xe ton kho</div>
                <p class="stat-value">@Model.TotalCarsInStock</p>
            </div>
            <div class="dash-stat-card__shimmer"></div>
        </article>
        <article class="stat-card dash-stat-card dash-stat-card--brands">
            <div class="dash-stat-card__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="dash-stat-card__content">
                <div class="stat-label">So hang xe dang quan ly</div>
                <p class="stat-value">@Model.BrandInventory.Count</p>
            </div>
            <div class="dash-stat-card__shimmer"></div>
        </article>
        <article class="stat-card dash-stat-card dash-stat-card--sales">
            <div class="dash-stat-card__icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div class="dash-stat-card__content">
                <div class="stat-label">Mau xe ban chay dang hien thi</div>
                <p class="stat-value">@Model.BestSellingCars.Count</p>
            </div>
            <div class="dash-stat-card__shimmer"></div>
        </article>
    </div>

    <!-- ═══════ SALES FILTER PANEL ═══════ -->
    <article class="panel-card dashboard-filter-panel dash-filter-premium">
        <form method="get" asp-action="Index" class="dashboard-filter-form">
            <div class="dashboard-filter-copy">
                <h2 class="h4 mb-1">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;vertical-align:-3px"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    Loc thong ke xe ban chay
                </h2>
                <p class="table-note mb-0">Chon khoang ngay tao don hang de xem top xe ban chay trong giai doan mong muon.</p>
            </div>
            <div class="dashboard-filter-fields">
                <div class="dash-filter-field">
                    <label class="form-label" for="salesFrom">Tu ngay</label>
                    <input class="form-control" id="salesFrom" name="salesFrom" type="date" value="@(Model.SalesFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="dash-filter-field">
                    <label class="form-label" for="salesTo">Den ngay</label>
                    <input class="form-control" id="salesTo" name="salesTo" type="date" value="@(Model.SalesTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="dashboard-filter-actions">
                    <button type="submit" class="btn btn-primary btn-dash-action">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Ap dung
                    </button>
                    @if (hasSalesFilter)
                    {
                        <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            Xoa loc
                        </a>
                    }
                </div>
            </div>
        </form>
    </article>

    <!-- ═══════ DATA PANELS ═══════ -->
    <div class="dashboard-grid dash-data-grid">
        <!-- ── Brand Inventory Table ── -->
        <article class="panel-card dash-table-panel">
            <div class="dash-table-header">
                <div>
                    <h2 class="h4 mb-1">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;vertical-align:-3px"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                        Thong ke ton kho theo hang
                    </h2>
                    <p class="table-note mb-0">Tong hop so luong xe hien con trong kho theo tung thuong hieu.</p>
                </div>
            </div>

            @if (Model.BrandInventory.Count == 0)
            {
                <div class="dash-empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    <p class="table-note mb-0">Hien chua co du lieu ton kho theo hang xe.</p>
                </div>
            }
            else
            {
                <div class="table-responsive dash-table-wrap">
                    <table class="table align-middle dash-table">
                        <thead>
                            <tr>
                                <th>
                                    <span class="dash-th-label">Hang xe</span>
                                </th>
                                <th class="text-end">
                                    <span class="dash-th-label">So luong ton</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BrandInventory)
                            {
                                <tr class="dash-table-row">
                                    <td>
                                        <span class="dash-brand-name">@item.BrandName</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="dash-number-badge">@item.StockQuantity</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <!-- ── Best Selling Cars Table ── -->
        <article class="panel-card dash-table-panel">
            <div class="dash-table-header">
                <div>
                    <h2 class="h4 mb-1">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;vertical-align:-3px"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        Thong ke xe ban chay
                    </h2>
                    <p class="table-note mb-0">
                        Cac mau xe noi bat dua tren nhung don hang da hoan tat, da thanh toan hoac da giao xe.
                        @if (hasSalesFilter)
                        {
                            <span class="dash-filter-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-1px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                Khoang loc hien tai: @(Model.SalesFrom?.ToString("dd/MM/yyyy") ?? "tat ca") - @(Model.SalesTo?.ToString("dd/MM/yyyy") ?? "tat ca").
                            </span>
                        }
                    </p>
                </div>
            </div>

            @if (Model.BestSellingCars.Count == 0)
            {
                <div class="dash-empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                    <p class="table-note mb-0">Hien chua co du lieu thong ke ban hang trong khoang da chon.</p>
                </div>
            }
            else
            {
                <div class="table-responsive dash-table-wrap">
                    <table class="table align-middle dash-table">
                        <thead>
                            <tr>
                                <th>
                                    <span class="dash-th-label">Mau xe</span>
                                </th>
                                <th>
                                    <span class="dash-th-label">Hang xe</span>
                                </th>
                                <th class="text-end">
                                    <span class="dash-th-label">Da ban</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BestSellingCars)
                            {
                                <tr class="dash-table-row">
                                    <td>
                                        <span class="dash-brand-name">@item.CarName</span>
                                    </td>
                                    <td>@item.BrandName</td>
                                    <td class="text-end">
                                        <span class="dash-number-badge dash-number-badge--sold">@item.SoldQuantity</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </div>
</section>
