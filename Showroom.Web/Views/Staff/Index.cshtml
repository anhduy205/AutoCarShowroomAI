@model IReadOnlyList<Showroom.Web.Models.StaffUser>

@{
    ViewData["Title"] = "Nhân viên";
    var message = TempData["StatusMessage"] as string;
    var type = TempData["StatusType"] as string ?? "info";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Core</span>
            <h1 class="dash-title-gradient">Quản lý nhân viên</h1>
            <p class="dash-subtitle">Tài khoản đăng nhập, phân quyền, chi nhánh và trạng thái hoạt động của nhân sự showroom.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Branches" asp-action="Index">Chi nhánh</a>
            <a class="btn btn-primary btn-dash-action" asp-action="Create">Thêm nhân viên</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-banner dash-status-banner status-@type">@message</div>
    }

    <article class="panel-card dash-table-panel">
        <div class="table-responsive dash-table-wrap">
            <table class="table align-middle dash-table">
                <thead>
                    <tr>
                        <th><span class="dash-th-label">Tài khoản</span></th>
                        <th><span class="dash-th-label">Nhân viên</span></th>
                        <th><span class="dash-th-label">Chi nhánh</span></th>
                        <th><span class="dash-th-label">Quyền</span></th>
                        <th><span class="dash-th-label">Trạng thái</span></th>
                        <th class="text-end"><span class="dash-th-label">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center table-note py-4">Chưa có tài khoản nhân viên nào trong database.</td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        <tr class="dash-table-row">
                            <td><span class="dash-number-badge">@user.Username</span></td>
                            <td>
                                <span class="dash-brand-name">@user.DisplayName</span>
                                @if (!string.IsNullOrWhiteSpace(user.StaffCode))
                                {
                                    <div class="table-note">@user.StaffCode</div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(user.BranchName) ? "Chưa gán" : user.BranchName)</td>
                            <td>@user.Role</td>
                            <td>@(user.IsActive ? "Đang hoạt động" : "Tạm khoá")</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@user.Id">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Xoá</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </article>
</section>
