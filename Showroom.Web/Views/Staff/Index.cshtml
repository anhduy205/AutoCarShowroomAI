@model IReadOnlyList<Showroom.Web.Models.StaffUser>
@{
    ViewData["Title"] = "Nhân viên";
    var message = TempData["StatusMessage"] as string;
    var type = TempData["StatusType"] as string ?? "info";
}

<section class="dashboard-shell">
    <header class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Quản lý nhân viên</h1>
            <p class="dashboard-subtitle mb-0">Tạo, cập nhật và phân quyền tài khoản nhân viên (lưu trong database).</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Create">Thêm nhân viên</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@type">@message</div>
    }

    <article class="panel-card">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Tên hiển thị</th>
                    <th>Quyen</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có tài khoản nhân viên nào trong database.</td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@user.Username</span></td>
                            <td>@user.DisplayName</td>
                            <td>@user.Role</td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@user.Id">Sửa</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </article>

    <div class="text-muted small mt-3">
        Lưu ý: Tài khoản quản trị cấu hình bằng <code>user-secrets</code> (AdminCredentials) không nằm trong danh sách này.
    </div>
</section>
