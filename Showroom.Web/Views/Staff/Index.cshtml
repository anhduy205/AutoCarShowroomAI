@model IReadOnlyList<Showroom.Web.Models.StaffUser>
@{
    ViewData["Title"] = "Nhân viên";
    var message = TempData["StatusMessage"] as string;
    var type = TempData["StatusType"] as string ?? "info";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Nhân sự</span>
            <h1 class="dash-title-gradient">Quản lý nhân viên</h1>
            <p class="dash-subtitle">Tạo, cập nhật và phân quyền tài khoản nhân viên (lưu trong database).</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary btn-dash-action" asp-action="Create">Thêm nhân viên</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-banner dash-status-banner status-@type">@message</div>
    }

    <article class="panel-card dash-table-panel">
        @if (Model.Count == 0)
        {
            <div class="dash-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                <p class="table-note mb-0">Chưa có tài khoản nhân viên nào trong database.</p>
            </div>
        }
        else
        {
            <div class="table-responsive dash-table-wrap">
                <table class="table align-middle dash-table">
                    <thead>
                    <tr>
                        <th><span class="dash-th-label">Tên đăng nhập</span></th>
                        <th><span class="dash-th-label">Tên hiển thị</span></th>
                        <th><span class="dash-th-label">Quyền</span></th>
                        <th><span class="dash-th-label">Ngày tạo</span></th>
                        <th class="text-end"><span class="dash-th-label">Thao tác</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="dash-table-row">
                            <td><span class="dash-brand-name">@user.Username</span></td>
                            <td>@user.DisplayName</td>
                            <td><span class="role-pill">@user.Role</span></td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@user.Id">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Xoá</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <div class="text-muted small mt-3">
        Lưu ý: Tài khoản quản trị cấu hình bằng <code>user-secrets</code> (AdminCredentials) không nằm trong danh sách này.
    </div>
</section>
