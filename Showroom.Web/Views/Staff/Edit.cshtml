@model Showroom.Web.Models.StaffUserFormViewModel
@{
    ViewData["Title"] = "Cap nhat nhan vien";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Nhan su</span>
            <h1 class="dash-title-gradient">Cap nhat nhan vien</h1>
            <p class="dash-subtitle">Cap nhat thong tin va reset mat khau (neu can).</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Quay lai</a>
        </div>
    </div>

    <article class="panel-card dash-form-premium">
        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-6 dash-filter-field">
                <label asp-for="Username" class="form-label">Ten dang nhap</label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="col-md-6 dash-filter-field">
                <label asp-for="DisplayName" class="form-label">Ten hien thi</label>
                <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>
            <div class="col-md-6 dash-filter-field">
                <label asp-for="Role" class="form-label">Quyen</label>
                <select asp-for="Role" class="form-select" asp-items="Model.RoleOptions"></select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-6 dash-filter-field">
                <label asp-for="Password" class="form-label">Mat khau moi (bo trong neu khong doi)</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-md-6 dash-filter-field">
                <label asp-for="ConfirmPassword" class="form-label">Xac nhan mat khau moi</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="col-12 page-actions">
                <button type="submit" class="btn btn-primary btn-dash-action">Luu</button>
                <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Huy</a>
            </div>
        </form>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
