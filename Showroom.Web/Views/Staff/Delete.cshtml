@model Showroom.Web.Models.StaffUser

@{
    ViewData["Title"] = "Xoá nhân viên";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Nhân viên</span>
            <h1 class="dash-title-gradient">Xoá tài khoản nhân viên</h1>
            <p class="dash-subtitle">Thao tác này sẽ xoá tài khoản đăng nhập trong database.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Quay lại</a>
        </div>
    </div>

    <article class="panel-card form-panel dash-form-premium">
        <div class="mb-3">
            <div><strong>@Model.Username</strong> - @Model.DisplayName</div>
            <div class="table-note">Quyền: @Model.Role</div>
            <div class="table-note">Chi nhánh: @(string.IsNullOrWhiteSpace(Model.BranchName) ? "Chưa gán" : Model.BranchName)</div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="page-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger btn-dash-action">Xác nhận xoá</button>
            <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Huỷ</a>
        </form>
    </article>
</section>
