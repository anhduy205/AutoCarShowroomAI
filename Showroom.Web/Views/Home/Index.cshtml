@model Showroom.Web.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Showroom xe sang";
}

<section class="hero-panel hero-premium">
    <div class="hero-copy">
        <span class="eyebrow eyebrow-glow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:-2px"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            Auto Car Showroom
        </span>
        <h1 class="hero-title-gradient">Không gian xe sang dành cho phong cách sống đẳng cấp.</h1>
        <p>
            Khám phá showroom ô tô được thiết kế cho khách hàng đề cao sự tinh tế,
            trải nghiệm tư vấn chuẩn mực và danh mục xe được tuyển chọn kỹ lưỡng từ nhiều thương hiệu uy tín.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary btn-lg btn-hero-action" href="/cars">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:-2px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Xem danh sách xe
            </a>
            <a class="btn btn-outline-light btn-lg btn-hero-action" asp-controller="Admin" asp-action="Login">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:-2px"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                Đăng nhập quản trị
            </a>
        </div>

        <div class="hero-metrics">
            <article class="metric-chip metric-chip-animated">
                <strong>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-2px"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Danh mục chọn lọc
                </strong>
                <span>Nhiều dòng sedan, SUV và crossover cao cấp.</span>
            </article>
            <article class="metric-chip metric-chip-animated">
                <strong>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-2px"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                    Tư vấn chuyên nghiệp
                </strong>
                <span>Đồng hành từ trải nghiệm xe đến quyết định sở hữu.</span>
            </article>
        </div>
    </div>

    <div class="hero-card-grid">
        <article class="hero-card spotlight-card hero-card-hover">
            <span class="card-tag">Kết nối đầu tiên</span>
            <h2>Không gian trưng bày tối giản, sang trọng và chuẩn cảm xúc xe sang.</h2>
            <p>Mọi khu vực được thiết kế để tôn lên đường nét, vật liệu và cá tính riêng của từng mẫu xe.</p>
        </article>
        <article class="hero-card hero-card-hover">
            <h2>Đa thương hiệu</h2>
            <p>Từ các mẫu xe phổ biến đến những lựa chọn nổi bật cho khách hàng tìm kiếm giá trị khác biệt.</p>
        </article>
        <article class="hero-card hero-card-hover">
            <h2>Quản trị chặt chẽ</h2>
            <p>Hệ thống hỗ trợ thống kê, quản lý danh mục và bảo vệ khu vực quản trị an toàn.</p>
        </article>
    </div>
</section>

<section class="panel-card p-4 mb-4 home-featured-section">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <span class="eyebrow eyebrow-glow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Gợi ý nhanh
            </span>
            <h2 class="h3 mb-1 dash-title-gradient">Xe nổi bật hôm nay</h2>
            <p class="mb-0 text-muted">Chọn nhanh mẫu xe phù hợp, hoặc mở chatbot để tư vấn theo ngân sách.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light btn-dash-action" href="/cars">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Xem tất cả
            </a>
            <button type="button" class="btn btn-primary btn-dash-action" data-chatbot-open data-chatbot-prefill="Tôi cần tư vấn chọn xe theo ngân sách và nhu cầu.">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Mở AI chatbot
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-warning mt-3 mb-0">@Model.StatusMessage</div>
    }
    else if (Model.FeaturedCars.Count == 0)
    {
        <div class="dash-empty-state mt-3">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <p class="table-note mb-0">Chưa có xe nào đang bán. Hãy quay lại sau.</p>
        </div>
    }
    else
    {
        <div class="row g-3 mt-1">
            @foreach (var car in Model.FeaturedCars)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="text-decoration-none" href="/cars/@car.Id">
                        <article class="car-card car-card-premium">
                            <div class="car-thumb">
                                @if (!string.IsNullOrWhiteSpace(car.ThumbnailUrl))
                                {
                                    <img src="@car.ThumbnailUrl" alt="Anh @car.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="car-thumb-placeholder">Không có ảnh</div>
                                }
                            </div>
                            <div class="car-card-body">
                                <h3 class="h5 mb-1">@car.Name</h3>
                                <div class="car-meta">@car.BrandName · @(string.IsNullOrWhiteSpace(car.Type) ? "-" : car.Type) · @(car.Year is null ? "-" : car.Year.Value.ToString())</div>
                                <div class="car-price">@car.Price.ToString("N0") VND</div>
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    }
</section>

<section class="feature-grid feature-grid-premium" id="vi-sao-chon">
    <article class="feature-card feature-card-hover">
        <span class="feature-index">01</span>
        <h3>Thiết kế đậm chất showroom cao cấp</h3>
        <p>Ngôn ngữ hình ảnh mạnh mẽ, ánh kim tinh tế và cảm giác sang trọng xuyên suốt từng điểm chạm.</p>
    </article>
    <article class="feature-card feature-card-hover">
        <span class="feature-index">02</span>
        <h3>Danh mục xe rõ ràng, dễ theo dõi</h3>
        <p>Hãng xe, mẫu xe, giá bán và tồn kho được trình bày mạch lạc để hỗ trợ tư vấn hiệu quả hơn.</p>
    </article>
    <article class="feature-card feature-card-hover">
        <span class="feature-index">03</span>
        <h3>Quản trị an toàn phía sau hậu trường</h3>
        <p>Khu quản trị riêng biệt giúp kiểm soát truy cập, cập nhật dữ liệu và theo dõi thống kê bán hàng.</p>
    </article>
</section>

<section class="collection-grid collection-grid-premium">
    <article class="collection-card featured collection-card-hover">
        <span class="eyebrow eyebrow-glow">Trải nghiệm</span>
        <h3>Định vị không gian mua xe tinh tế</h3>
        <p>
            Auto Car Showroom được xây dựng để mang đến cảm giác chuyên nghiệp ngay từ lần ghé đầu tiên:
            giao diện sang trọng, nội dung rõ ràng và hành trình khám phá mạch lạc.
        </p>
    </article>
    <article class="collection-card collection-card-hover">
        <span class="eyebrow">Tin cậy</span>
        <h3>Thống kê và quản lý đồng bộ</h3>
        <p>Hệ thống ghi nhận số lượng xe theo hãng, xe bán chạy và tổng lượng xe trong showroom theo thời gian thực.</p>
    </article>
    <article class="collection-card collection-card-hover">
        <span class="eyebrow">Hiệu quả</span>
        <h3>Hỗ trợ đội ngũ vận hành</h3>
        <p>Thông tin cập nhật tập trung giúp nhân viên và quản trị viên phối hợp nhanh, chính xác và nhất quán.</p>
    </article>
</section>
