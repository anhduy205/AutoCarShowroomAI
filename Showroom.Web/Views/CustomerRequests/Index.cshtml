@model IReadOnlyList<Showroom.Web.Models.CustomerRequestListItemViewModel>

@{
    ViewData["Title"] = "Yeu cau khach hang";
    var statusMessage = TempData["StatusMessage"] as string;
    var statusType = TempData["StatusType"] as string ?? "success";
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Cham soc khach hang</span>
            <h1>Yeu cau khach hang</h1>
            <p>Xac nhan cac yeu cau dat lich xem xe, tu van, dat coc truoc va lich lai thu.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">Ve bang dieu khien</a>
            <a class="btn btn-primary" asp-controller="Requests" asp-action="Create">Tao yeu cau ho khach</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner status-@statusType">
            @statusMessage
        </div>
    }

    <article class="panel-card">
        @if (Model.Count == 0)
        {
            <p class="empty-state mb-0">Chua co yeu cau nao tu khach hang.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Ma</th>
                            <th>Nhu cau</th>
                            <th>Khach hang</th>
                            <th>Xe</th>
                            <th>Hen lich</th>
                            <th>Trang thai</th>
                            <th class="text-end">Thao tac</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                CustomerRequestCatalog.Confirmed => "status-success",
                                CustomerRequestCatalog.Cancelled => "status-danger",
                                _ => "status-warning"
                            };

                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.RequestTypeLabel</td>
                                <td>
                                    <strong>@item.CustomerName</strong><br />
                                    <span class="table-note">@(!string.IsNullOrWhiteSpace(item.CustomerEmail) ? item.CustomerEmail : item.CustomerPhone)</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.CarName) ? "-" : item.CarName)</td>
                                <td>@(item.PreferredTime is null ? "-" : item.PreferredTime.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>
                                    <span class="status-chip @statusClass">@item.StatusLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(item.NotificationChannel))
                                    {
                                        <div class="table-note">Da thong bao qua @item.NotificationChannel</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Xem</a>
                                        @if (item.Status == CustomerRequestCatalog.Pending)
                                        {
                                            <form asp-action="Confirm" asp-route-id="@item.Id" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">Xac nhan</button>
                                            </form>
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="inline-form" onsubmit="return confirm('Huy yeu cau nay?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Huy</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>
