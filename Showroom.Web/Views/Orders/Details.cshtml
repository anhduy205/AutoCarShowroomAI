@model Showroom.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var statusClass = Model.Status switch
    {
        OrderStatusCatalog.Paid or OrderStatusCatalog.Completed or OrderStatusCatalog.Delivered => "status-success",
        OrderStatusCatalog.Cancelled => "status-danger",
        _ => "status-warning"
    };
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Đơn hàng</span>
            <h1 class="dash-title-gradient">Chi tiết đơn hàng #@Model.Id</h1>
            <p class="dash-subtitle">Xem thông tin khách hàng, danh sách xe và tổng tiền.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Quay lại</a>
            <a class="btn btn-primary btn-dash-action" asp-action="Edit" asp-route-id="@Model.Id">Sửa đơn</a>
        </div>
    </div>

    <article class="panel-card dash-table-panel">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="dash-table-header">
                    <h2 class="h5 mb-0">Thông tin</h2>
                </div>
                <div class="detail-spec-card p-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Khách hàng</dt>
                        <dd class="col-sm-8"><span class="dash-brand-name">@Model.CustomerName</span></dd>
                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8"><span class="status-chip @statusClass">@Model.Status</span></dd>
                        <dt class="col-sm-4">Số điện thoại</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.CustomerPhone) ? Model.CustomerPhone : "-")</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.CustomerEmail) ? Model.CustomerEmail : "-")</dd>
                        <dt class="col-sm-4">Địa chỉ</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.CustomerAddress) ? Model.CustomerAddress : "-")</dd>
                        <dt class="col-sm-4">Ngày tạo</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <hr />
                    <h3 class="h6">Ghi chú</h3>
                    <p class="mb-0">@Model.Note</p>
                }
            </div>

            <div class="col-lg-6">
                <div class="dash-table-header">
                    <h2 class="h5 mb-0">Tổng kết</h2>
                </div>
                <div class="detail-spec-card p-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Tổng số xe</dt>
                        <dd class="col-sm-6 text-end"><span class="dash-number-badge">@Model.TotalQuantity</span></dd>
                        <dt class="col-sm-6">Tổng tiền</dt>
                        <dd class="col-sm-6 text-end"><span class="dash-brand-name" style="color:var(--primary);font-size:1.1rem">@Model.TotalAmount.ToString("N0") VNĐ</span></dd>
                    </dl>
                </div>
            </div>
        </div>
    </article>

    <article class="panel-card dash-table-panel mt-4">
        <div class="dash-table-header">
            <h2 class="h5 mb-0">Danh sách xe</h2>
        </div>
        @if (Model.Items.Count == 0)
        {
            <div class="dash-empty-state">
                <p class="table-note mb-0">Đơn hàng chưa có dòng xe nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive dash-table-wrap">
                <table class="table align-middle dash-table">
                    <thead>
                        <tr>
                            <th><span class="dash-th-label">Xe</span></th>
                            <th><span class="dash-th-label">Hãng</span></th>
                            <th class="text-end"><span class="dash-th-label">Số lượng</span></th>
                            <th class="text-end"><span class="dash-th-label">Đơn giá</span></th>
                            <th class="text-end"><span class="dash-th-label">Thành tiền</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="dash-table-row">
                                <td><span class="dash-brand-name">@item.CarName</span></td>
                                <td>@item.BrandName</td>
                                <td class="text-end"><span class="dash-number-badge">@item.Quantity</span></td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                                <td class="text-end"><span class="dash-brand-name" style="color:var(--primary)">@item.LineTotal.ToString("N0") VNĐ</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="dash-table-row" style="border-top:2px solid rgba(37,99,235,0.14);">
                            <th colspan="2" class="text-end">Tổng</th>
                            <th class="text-end"><span class="dash-number-badge">@Model.TotalQuantity</span></th>
                            <th></th>
                            <th class="text-end" style="color:var(--primary);font-weight:800;">@Model.TotalAmount.ToString("N0") VNĐ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </article>
</section>
