@model IReadOnlyList<Showroom.Web.Models.OrderListItemViewModel>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var statusMessage = TempData["StatusMessage"] as string;
    var statusType = TempData["StatusType"] as string ?? "success";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Giao dịch</span>
            <h1 class="dash-title-gradient">Quản lý đơn hàng</h1>
            <p class="dash-subtitle">Tạo, cập nhật và theo dõi các đơn hàng phát sinh để dữ liệu bán hàng luôn đồng bộ với thống kê showroom.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Admin" asp-action="Index">Về bảng điều khiển</a>
            <a class="btn btn-primary btn-dash-action" asp-action="Create">Tạo đơn hàng</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner dash-status-banner status-@statusType">@statusMessage</div>
    }

    <article class="panel-card dash-table-panel">
        @if (Model.Count == 0)
        {
            <div class="dash-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <p class="table-note mb-0">Hiện chưa có đơn hàng nào. Bạn có thể tạo đơn hàng đầu tiên ngay bây giờ.</p>
            </div>
        }
        else
        {
            <div class="table-responsive dash-table-wrap">
                <table class="table align-middle dash-table">
                    <thead>
                        <tr>
                            <th><span class="dash-th-label">Mã đơn</span></th>
                            <th><span class="dash-th-label">Khách hàng</span></th>
                            <th><span class="dash-th-label">Trạng thái</span></th>
                            <th class="text-end"><span class="dash-th-label">Tổng xe</span></th>
                            <th class="text-end"><span class="dash-th-label">Tổng tiền</span></th>
                            <th class="text-end"><span class="dash-th-label">Ngày tạo</span></th>
                            <th class="text-end"><span class="dash-th-label">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                OrderStatusCatalog.Paid or OrderStatusCatalog.Completed or OrderStatusCatalog.Delivered => "status-success",
                                OrderStatusCatalog.Cancelled => "status-danger",
                                _ => "status-warning"
                            };

                            <tr class="dash-table-row">
                                <td><span class="dash-brand-name">#@item.Id</span></td>
                                <td>@item.CustomerName</td>
                                <td><span class="status-chip @statusClass">@item.Status</span></td>
                                <td class="text-end"><span class="dash-number-badge">@item.TotalQuantity</span></td>
                                <td class="text-end"><span class="dash-brand-name" style="color:var(--primary)">@item.TotalAmount.ToString("N0") VNĐ</span></td>
                                <td class="text-end">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Xem</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-form" onsubmit="return confirm('Bạn có chắc muốn xoá đơn hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>
