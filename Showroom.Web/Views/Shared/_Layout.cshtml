<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auto Car Showroom</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Showroom.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <div class="app-backdrop"></div>

    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var isAdministrator = User.IsInRole(ShowroomRoles.Administrator);
        var isStaff = User.IsInRole(ShowroomRoles.Staff);
        var roleLabel = isAdministrator ? "Quản trị viên" : isStaff ? "Nhân viên được ủy quyền" : string.Empty;
    }

    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid app-nav-container">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">AC</span>
                    <span class="brand-copy">
                        <strong>Auto Car Showroom</strong>
                        <small>Không gian xe sang dành cho người tinh chọn</small>
                    </span>
                </a>
                <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Dieu huong">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/cars">Xe đang bán</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Requests" asp-action="Create">Tu van / Dat lich</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Index">Bảng điều khiển</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">Đơn hàng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="CustomerRequests" asp-action="Index">Yeu cau khach</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Reports" asp-action="Index">Báo cáo</a>
                            </li>
                            @if (isAdministrator)
                            {
                                <li class="nav-item dropdown app-nav-dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="managementMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                                        Quản lý
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark app-dropdown" aria-labelledby="managementMenu">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Brands" asp-action="Index">Hãng xe</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Cars" asp-action="Index">Quản lý xe</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Staff" asp-action="Index">Nhân viên</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AuditLogs" asp-action="Index">Nhật ký</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <div class="navbar-account">
                        @if (isAuthenticated)
                        {
                            <div class="dropdown account-menu">
                                <button class="btn btn-outline-light account-toggle dropdown-toggle" type="button" id="accountMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrWhiteSpace(roleLabel))
                                    {
                                        @roleLabel
                                    }
                                    else
                                    {
                                        @User.Identity!.Name
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end app-dropdown account-dropdown" aria-labelledby="accountMenu">
                                    <li>
                                        <span class="dropdown-header">Xin chào, @User.Identity!.Name</span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Admin" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light" asp-controller="Admin" asp-action="Login">Đăng nhập quản trị</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-panel">
        <div class="container">
            <div class="footer-copy">
                <span>&copy; 2026 Auto Car Showroom</span>
                <span>Giao diện quản trị an toàn cho showroom ô tô cao cấp.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ChatBot" />
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
