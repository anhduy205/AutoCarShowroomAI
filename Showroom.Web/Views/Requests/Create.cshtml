@model Showroom.Web.Models.CustomerRequestFormViewModel

@{
    ViewData["Title"] = "Gửi yêu cầu showroom";
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Dịch vụ showroom</span>
            <h1>Gửi yêu cầu</h1>
            <p>Chọn nhu cầu, để lại thông tin liên hệ. Quản trị sẽ xác nhận và thông báo lại qua email hoặc số điện thoại.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/cars">Xem xe đang bán</a>
        </div>
    </div>

    <article class="panel-card form-panel">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-grid">
                <div class="mb-3">
                    <label asp-for="RequestType" class="form-label"></label>
                    <select asp-for="RequestType" asp-items="Model.RequestTypeOptions" class="form-select form-select-lg"></select>
                    <span asp-validation-for="RequestType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CarId" class="form-label"></label>
                    <select asp-for="CarId" asp-items="Model.CarOptions" class="form-select form-select-lg"></select>
                    <span asp-validation-for="CarId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control form-control-lg" placeholder="Họ tên của bạn" />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PreferredTime" class="form-label"></label>
                    <input asp-for="PreferredTime" type="datetime-local" class="form-control form-control-lg" />
                    <span asp-validation-for="PreferredTime" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerPhone" class="form-label"></label>
                    <input asp-for="CustomerPhone" class="form-control form-control-lg" placeholder="0901xxxxxx" />
                    <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerEmail" class="form-label"></label>
                    <input asp-for="CustomerEmail" class="form-control form-control-lg" placeholder="email@domain.com" />
                    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DepositAmount" class="form-label"></label>
                    <input asp-for="DepositAmount" class="form-control form-control-lg" min="0" step="1000000" placeholder="Chỉ cần nhập khi đặt cọc" />
                    <span asp-validation-for="DepositAmount" class="text-danger"></span>
                </div>

                <div class="mb-3" style="grid-column: 1 / -1;">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="4" placeholder="Mẫu xe, chi nhánh, khung giờ hoặc nội dung cần tư vấn..."></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
            </div>

            <div class="page-actions mt-4">
                <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                <a class="btn btn-outline-secondary" href="/cars">Quay lại</a>
            </div>
        </form>
    </article>

    <article class="panel-card mt-4">
        <h2 class="h4 mb-3">Quy trình dịch vụ</h2>
        <div class="row g-3">
            @foreach (var option in CustomerRequestCatalog.GetTypeSelectList())
            {
                <div class="col-md-6">
                    <div class="request-guide-block">
                        <h3 class="h5">@option.Text</h3>
                        <p class="mb-2">@CustomerRequestCatalog.GetPublicDescription(option.Value)</p>
                        <ul class="mb-0">
                            @foreach (var step in CustomerRequestCatalog.GetStaffChecklist(option.Value).Take(3))
                            {
                                <li>@step</li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
