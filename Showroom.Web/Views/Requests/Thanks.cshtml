@{
    ViewData["Title"] = "Đã gửi yêu cầu";
    var statusMessage = TempData["StatusMessage"] as string;
    var statusType = TempData["StatusType"] as string ?? "success";
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Cam on ban</span>
            <h1>Showroom đã nhận yêu cầu</h1>
            <p>Quản trị viên sẽ kiểm tra và xác nhận. Sau khi xác nhận, bạn sẽ nhận thông báo qua email hoặc số điện thoại đã cung cấp.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" href="/cars">Tiep tuc xem xe</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner status-@statusType">
            @statusMessage
        </div>
    }
</section>
