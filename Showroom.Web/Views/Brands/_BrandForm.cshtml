@model Showroom.Web.Models.BrandFormViewModel

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Hãng xe</span>
            <h1 class="dash-title-gradient">@ViewData["PageTitle"]</h1>
            <p class="dash-subtitle">@ViewData["PageDescription"]</p>
        </div>
    </div>

    <article class="panel-card form-panel dash-form-premium">
        <form asp-action="@ViewData["FormAction"]" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4 dash-filter-field">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="Ví dụ: Toyota, Hyundai..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="page-actions">
                <button type="submit" class="btn btn-primary btn-dash-action">@ViewData["SubmitText"]</button>
                <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Quay lại</a>
            </div>
        </form>
    </article>
</section>
