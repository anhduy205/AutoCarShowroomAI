@model IReadOnlyList<Showroom.Web.Models.AuditLogListItemViewModel>

@{
    ViewData["Title"] = "Nhat ky hoat dong";
    var statusMessage = ViewData["StatusMessage"] as string;
    var statusType = ViewData["StatusType"] as string ?? "success";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Bao mat</span>
            <h1 class="dash-title-gradient">Nhat ky hoat dong</h1>
            <p class="dash-subtitle">Theo doi cac su kien quan trong trong khu vuc quan tri de phuc vu kiem tra va bao cao.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Admin" asp-action="Index">Ve bang dieu khien</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner dash-status-banner status-@statusType">@statusMessage</div>
    }

    <article class="panel-card dash-table-panel">
        @if (Model.Count == 0)
        {
            <div class="dash-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <p class="table-note mb-0">Chua co du lieu nhat ky hoat dong.</p>
            </div>
        }
        else
        {
            <div class="table-responsive dash-table-wrap">
                <table class="table align-middle dash-table">
                    <thead>
                        <tr>
                            <th><span class="dash-th-label">Thoi gian</span></th>
                            <th><span class="dash-th-label">Nguoi dung</span></th>
                            <th><span class="dash-th-label">Hanh dong</span></th>
                            <th><span class="dash-th-label">Doi tuong</span></th>
                            <th><span class="dash-th-label">Mo ta</span></th>
                            <th><span class="dash-th-label">IP</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="dash-table-row">
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="dash-brand-name">@item.DisplayName</div>
                                    <div class="table-note">@item.Username · @item.Role</div>
                                </td>
                                <td><span class="status-chip status-warning">@item.Action</span></td>
                                <td>
                                    @item.EntityType
                                    @if (item.EntityId is not null)
                                    {
                                        <span class="dash-number-badge" style="font-size:0.75rem">#@item.EntityId</span>
                                    }
                                </td>
                                <td>@item.Description</td>
                                <td>@(string.IsNullOrWhiteSpace(item.IpAddress) ? "-" : item.IpAddress)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>
