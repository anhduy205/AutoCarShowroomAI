@model Showroom.Web.Controllers.ReportsIndexViewModel
@{
    ViewData["Title"] = "Bao cao";
    var tab = Model.Tab;
    var isSales = tab == "sales";
    var isInventory = tab == "inventory";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Bao cao</span>
            <h1 class="dash-title-gradient">Bao cao &amp; thong ke</h1>
            <p class="dash-subtitle">Loc theo hang, khoang thoi gian va tai file CSV de xu ly them.</p>
        </div>
        <div class="page-actions">
            @if (isSales)
            {
                <a class="btn btn-outline-secondary btn-dash-action"
                   href="/Reports/Sales.csv?from=@(Model.From?.ToString("yyyy-MM-dd"))&to=@(Model.To?.ToString("yyyy-MM-dd"))&brandId=@(Model.BrandId?.ToString() ?? string.Empty)">
                    Xuat CSV
                </a>
            }
            else
            {
                <a class="btn btn-outline-secondary btn-dash-action"
                   href="/Reports/Inventory.csv?brandId=@(Model.BrandId?.ToString() ?? string.Empty)&status=@(Model.Status ?? string.Empty)">
                    Xuat CSV
                </a>
            }
        </div>
    </div>

    <article class="panel-card dashboard-filter-panel dash-filter-premium">
        <form method="get" action="/Reports" class="dashboard-filter-form">
            <div class="dashboard-filter-fields">
                <div class="dash-filter-field">
                    <label class="form-label">Loai bao cao</label>
                    <select class="form-select" name="tab">
                        @if (isSales)
                        {
                            <option value="sales" selected>Ban hang</option>
                        }
                        else
                        {
                            <option value="sales">Ban hang</option>
                        }
                        @if (isInventory)
                        {
                            <option value="inventory" selected>Ton kho</option>
                        }
                        else
                        {
                            <option value="inventory">Ton kho</option>
                        }
                    </select>
                </div>
                <div class="dash-filter-field">
                    <label class="form-label">Hang xe</label>
                    <select class="form-select" name="brandId">
                        @foreach (var opt in Model.BrandOptions)
                        {
                            if (opt.Selected)
                            {
                                <option value="@opt.Value" selected>@opt.Text</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        }
                    </select>
                </div>

                @if (isSales)
                {
                    <div class="dash-filter-field">
                        <label class="form-label">Tu ngay</label>
                        <input class="form-control" type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="dash-filter-field">
                        <label class="form-label">Den ngay</label>
                        <input class="form-control" type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
                    </div>
                }
                else
                {
                    <div class="dash-filter-field">
                        <label class="form-label">Trang thai</label>
                        <select class="form-select" name="status">
                            @foreach (var opt in Model.InventoryStatusOptions)
                            {
                                if (opt.Selected)
                                {
                                    <option value="@opt.Value" selected>@opt.Text</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            }
                        </select>
                    </div>
                }
            </div>

            <div class="dashboard-filter-actions">
                <button class="btn btn-primary btn-dash-action" type="submit">Ap dung</button>
                <a class="btn btn-outline-secondary btn-dash-action" href="/Reports">Xoa loc</a>
            </div>
        </form>
    </article>

    @if (isSales && Model.Sales is not null)
    {
        <div class="metrics-grid dash-metrics-premium">
            <article class="stat-card dash-stat-card dash-stat-card--brands">
                <div class="dash-stat-card__content">
                    <div class="stat-label">Hang dang loc</div>
                    <p class="stat-value">@Model.Sales.BrandLabel</p>
                </div>
            </article>
            <article class="stat-card dash-stat-card dash-stat-card--sales">
                <div class="dash-stat-card__content">
                    <div class="stat-label">Tong so xe da ban</div>
                    <p class="stat-value">@Model.Sales.TotalQuantity</p>
                </div>
            </article>
            <article class="stat-card dash-stat-card dash-stat-card--inventory">
                <div class="dash-stat-card__content">
                    <div class="stat-label">Tong doanh thu</div>
                    <p class="stat-value">@Model.Sales.TotalAmount.ToString("N0")</p>
                </div>
            </article>
        </div>

        <div class="dashboard-grid dash-data-grid">
            <article class="panel-card dash-table-panel">
                <div class="dash-table-header">
                    <div>
                        <h2 class="h4 mb-1">Top xe ban chay</h2>
                        <p class="table-note mb-0">Loc theo Paid/Completed/Delivered.</p>
                    </div>
                </div>
                @if (Model.Sales.TopCars.Count == 0)
                {
                    <div class="dash-empty-state"><p class="table-note mb-0">Chua co du lieu ban hang trong khoang loc.</p></div>
                }
                else
                {
                    <div class="table-responsive dash-table-wrap">
                        <table class="table align-middle dash-table">
                            <thead><tr>
                                <th><span class="dash-th-label">Xe</span></th>
                                <th><span class="dash-th-label">Hang</span></th>
                                <th class="text-end"><span class="dash-th-label">Da ban</span></th>
                                <th class="text-end"><span class="dash-th-label">Doanh thu</span></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var row in Model.Sales.TopCars)
                            {
                                <tr class="dash-table-row">
                                    <td><span class="dash-brand-name">@row.CarName</span></td>
                                    <td>@row.BrandName</td>
                                    <td class="text-end"><span class="dash-number-badge dash-number-badge--sold">@row.SoldQuantity</span></td>
                                    <td class="text-end">@row.Amount.ToString("N0")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="panel-card dash-table-panel">
                <div class="dash-table-header">
                    <div>
                        <h2 class="h4 mb-1">Tong hop theo hang</h2>
                        <p class="table-note mb-0">Tong quan doanh thu va so luong theo hang.</p>
                    </div>
                </div>
                @if (Model.Sales.Brands.Count == 0)
                {
                    <div class="dash-empty-state"><p class="table-note mb-0">Chua co du lieu.</p></div>
                }
                else
                {
                    <div class="table-responsive dash-table-wrap">
                        <table class="table align-middle dash-table">
                            <thead><tr>
                                <th><span class="dash-th-label">Hang</span></th>
                                <th class="text-end"><span class="dash-th-label">Da ban</span></th>
                                <th class="text-end"><span class="dash-th-label">Doanh thu</span></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var row in Model.Sales.Brands)
                            {
                                <tr class="dash-table-row">
                                    <td><span class="dash-brand-name">@row.BrandName</span></td>
                                    <td class="text-end"><span class="dash-number-badge dash-number-badge--sold">@row.SoldQuantity</span></td>
                                    <td class="text-end">@row.Amount.ToString("N0")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        </div>
    }
    else if (isInventory && Model.Inventory is not null)
    {
        <div class="metrics-grid dash-metrics-premium">
            <article class="stat-card dash-stat-card dash-stat-card--brands">
                <div class="dash-stat-card__content">
                    <div class="stat-label">Hang dang loc</div>
                    <p class="stat-value">@Model.Inventory.BrandLabel</p>
                </div>
            </article>
            <article class="stat-card dash-stat-card dash-stat-card--inventory">
                <div class="dash-stat-card__content">
                    <div class="stat-label">So mau xe</div>
                    <p class="stat-value">@Model.Inventory.TotalCars</p>
                </div>
            </article>
            <article class="stat-card dash-stat-card dash-stat-card--sales">
                <div class="dash-stat-card__content">
                    <div class="stat-label">Tong ton kho</div>
                    <p class="stat-value">@Model.Inventory.TotalStockQuantity</p>
                </div>
            </article>
        </div>

        <div class="dashboard-grid dash-data-grid">
            <article class="panel-card dash-table-panel">
                <div class="dash-table-header">
                    <div>
                        <h2 class="h4 mb-1">Tong hop trang thai</h2>
                        <p class="table-note mb-0">Dem so mau xe va tong ton theo trang thai.</p>
                    </div>
                </div>
                @if (Model.Inventory.StatusSummary.Count == 0)
                {
                    <div class="dash-empty-state"><p class="table-note mb-0">Chua co du lieu.</p></div>
                }
                else
                {
                    <div class="table-responsive dash-table-wrap">
                        <table class="table align-middle dash-table">
                            <thead><tr>
                                <th><span class="dash-th-label">Trang thai</span></th>
                                <th class="text-end"><span class="dash-th-label">So mau</span></th>
                                <th class="text-end"><span class="dash-th-label">Tong ton</span></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var row in Model.Inventory.StatusSummary)
                            {
                                <tr class="dash-table-row">
                                    <td>@row.Status</td>
                                    <td class="text-end"><span class="dash-number-badge">@row.CarCount</span></td>
                                    <td class="text-end"><span class="dash-number-badge">@row.StockQuantity</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="panel-card dash-table-panel">
                <div class="dash-table-header">
                    <div>
                        <h2 class="h4 mb-1">Danh sach xe</h2>
                        <p class="table-note mb-0">Toi da 300 dong cho moi lan xem (CSV de lay day du).</p>
                    </div>
                </div>
                @if (Model.Inventory.Cars.Count == 0)
                {
                    <div class="dash-empty-state"><p class="table-note mb-0">Chua co xe phu hop bo loc.</p></div>
                }
                else
                {
                    <div class="table-responsive dash-table-wrap">
                        <table class="table align-middle dash-table">
                            <thead><tr>
                                <th><span class="dash-th-label">Xe</span></th>
                                <th><span class="dash-th-label">Hang</span></th>
                                <th><span class="dash-th-label">Trang thai</span></th>
                                <th class="text-end"><span class="dash-th-label">Ton</span></th>
                                <th class="text-end"><span class="dash-th-label">Gia</span></th>
                                <th class="text-end"><span class="dash-th-label">Nam</span></th>
                                <th><span class="dash-th-label">Loai</span></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var row in Model.Inventory.Cars)
                            {
                                <tr class="dash-table-row">
                                    <td><span class="dash-brand-name">@row.CarName</span></td>
                                    <td>@row.BrandName</td>
                                    <td>@row.Status</td>
                                    <td class="text-end"><span class="dash-number-badge">@row.StockQuantity</span></td>
                                    <td class="text-end">@row.Price.ToString("N0")</td>
                                    <td class="text-end">@(row.Year?.ToString() ?? "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Type) ? "-" : row.Type)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        </div>
    }
</section>
