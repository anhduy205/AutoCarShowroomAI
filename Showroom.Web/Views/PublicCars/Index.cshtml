@model Showroom.Web.Models.PublicCarsIndexViewModel

@{
    ViewData["Title"] = "Xe ô tô";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Query)
        || Model.BrandId is not null
        || !string.IsNullOrWhiteSpace(Model.Type)
        || Model.MinPrice is not null
        || Model.MaxPrice is not null
        || Model.YearFrom is not null
        || Model.YearTo is not null;
    var selectedBrand = Model.BrandId is null
        ? null
        : Model.BrandOptions.FirstOrDefault(option => option.Value == Model.BrandId.Value.ToString())?.Text;
}

<section class="market-page">
    <form method="get" action="/cars" class="market-shell">
        <aside class="market-filter" aria-label="Bộ lọc xe">
            <h2>BỘ LỌC</h2>

            <div class="market-filter-section open">
                <button type="button">HÃNG XE, DÒNG XE <span>⌄</span></button>
                <select class="form-select" name="brandId">
                    <option value="">Tất cả hãng</option>
                    @foreach (var option in Model.BrandOptions)
                    {
                        var isSelected = Model.BrandId is not null && option.Value == Model.BrandId.Value.ToString();
                        if (isSelected)
                        {
                            <option value="@option.Value" selected>@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="market-filter-section open">
                <button type="button">KIỂU DÁNG <span>⌄</span></button>
                <select class="form-select" name="type">
                    @foreach (var option in Model.TypeOptions)
                    {
                        if (option.Selected)
                        {
                            <option value="@option.Value" selected>@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="market-filter-section open">
                <button type="button">GIÁ <span>⌄</span></button>
                <div class="market-range-grid">
                    <input class="form-control" type="number" min="0" step="1000000" name="minPrice" value="@(Model.MinPrice?.ToString() ?? string.Empty)" placeholder="Từ" />
                    <input class="form-control" type="number" min="0" step="1000000" name="maxPrice" value="@(Model.MaxPrice?.ToString() ?? string.Empty)" placeholder="Đến" />
                </div>
            </div>

            <div class="market-filter-section open">
                <button type="button">NĂM SẢN XUẤT <span>⌄</span></button>
                <div class="market-range-grid">
                    <input class="form-control" type="number" min="1900" max="2100" step="1" name="yearFrom" value="@(Model.YearFrom?.ToString() ?? string.Empty)" placeholder="Từ" />
                    <input class="form-control" type="number" min="1900" max="2100" step="1" name="yearTo" value="@(Model.YearTo?.ToString() ?? string.Empty)" placeholder="Đến" />
                </div>
            </div>


            <div class="market-filter-actions">
                <button class="btn btn-primary" type="submit">Áp dụng</button>
                <a class="btn btn-outline-secondary" href="/cars">Xóa lọc</a>
            </div>
        </aside>

        <main class="market-results">
            <div class="market-search">
                <span aria-hidden="true">⌕</span>
                <input class="form-control"
                       name="q"
                       value="@Model.Query"
                       placeholder="Tìm kiếm xe theo Hãng xe, Dòng xe hoặc Từ khóa" />
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>
            </div>

            <div class="market-active-filters">
                <strong>BỘ LỌC</strong>
                @if (hasFilters)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.Query))
                    {
                        <span>@Model.Query</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedBrand))
                    {
                        <span>@selectedBrand</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Type))
                    {
                        <span>@Model.Type</span>
                    }
                    @if (Model.MinPrice is not null || Model.MaxPrice is not null)
                    {
                        <span>
                            @(Model.MinPrice?.ToString("N0") ?? "0") đến @(Model.MaxPrice?.ToString("N0") ?? "không giới hạn")
                        </span>
                    }
                }
                else
                {
                    <span>Tất cả xe</span>
                }
            </div>

            <div class="market-result-heading">

                <label class="market-sort">
                    <span>SẮP XẾP:</span>
                    <select class="form-select" name="sort" onchange="this.form.submit()">
                        @if (Model.Sort == PublicCarSortCatalog.Relevance)
                        {
                            <option value="@PublicCarSortCatalog.Relevance" selected>Liên quan nhất</option>
                        }
                        else
                        {
                            <option value="@PublicCarSortCatalog.Relevance">Liên quan nhất</option>
                        }

                        @if (Model.Sort == PublicCarSortCatalog.Newest)
                        {
                            <option value="@PublicCarSortCatalog.Newest" selected>Mới nhất</option>
                        }
                        else
                        {
                            <option value="@PublicCarSortCatalog.Newest">Mới nhất</option>
                        }

                        @if (Model.Sort == PublicCarSortCatalog.PriceAsc)
                        {
                            <option value="@PublicCarSortCatalog.PriceAsc" selected>Giá thấp đến cao</option>
                        }
                        else
                        {
                            <option value="@PublicCarSortCatalog.PriceAsc">Giá thấp đến cao</option>
                        }

                        @if (Model.Sort == PublicCarSortCatalog.PriceDesc)
                        {
                            <option value="@PublicCarSortCatalog.PriceDesc" selected>Giá cao đến thấp</option>
                        }
                        else
                        {
                            <option value="@PublicCarSortCatalog.PriceDesc">Giá cao đến thấp</option>
                        }

                        @if (Model.Sort == PublicCarSortCatalog.YearDesc)
                        {
                            <option value="@PublicCarSortCatalog.YearDesc" selected>Năm mới nhất</option>
                        }
                        else
                        {
                            <option value="@PublicCarSortCatalog.YearDesc">Năm mới nhất</option>
                        }
                    </select>
                </label>
            </div>

            @if (Model.Cars.Count == 0)
            {
                <article class="market-empty">
                    Không tìm thấy xe phù hợp. Hãy thử thay đổi bộ lọc.
                </article>
            }
            else
            {
                <div class="market-card-grid">
                    @foreach (var car in Model.Cars)
                    {
                        <a class="market-car-card" href="/cars/@car.Id">
                            <div class="market-car-image">
                                @if (!string.IsNullOrWhiteSpace(car.ThumbnailUrl))
                                {
                                    <img src="@car.ThumbnailUrl" alt="Ảnh @car.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="market-car-placeholder">
                                        <strong>@car.BrandName</strong>
                                        <span>@car.Type</span>
                                    </div>
                                }
                                <span class="market-image-dots"></span>
                            </div>
                            <div class="market-car-body">
                                <h2>@car.Name</h2>
                                <div class="market-car-specs">
                                    <span>@(car.Year?.ToString() ?? "No data")</span>
                                    <span>@(string.IsNullOrWhiteSpace(car.Type) ? "Xe mới" : car.Type)</span>
                                    <span>@(string.IsNullOrWhiteSpace(car.Color) ? "Màu đang cập nhật" : car.Color)</span>
                                    <span>@car.Status</span>
                                </div>
                                <div class="market-car-price">@car.Price.ToString("N0") VNĐ</div>
                                <div class="market-car-location">Auto Car Showroom</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </main>
    </form>
</section>
