@model Showroom.Web.Models.CarDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    var statusLabel = Model.Status switch
    {
        CarStatusCatalog.InStock => "Còn hàng",
        CarStatusCatalog.Promotion => "Khuyến mãi",
        CarStatusCatalog.Sold => "Đã bán",
        _ => Model.Status
    };
    var statusClass = Model.Status switch
    {
        CarStatusCatalog.InStock => "status-success",
        CarStatusCatalog.Promotion => "status-warning",
        CarStatusCatalog.Sold => "status-danger",
        _ => "status-warning"
    };
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Xe đang bán</span>
            <h1 class="mb-2">@Model.Name</h1>
            <p class="mb-0">@Model.BrandName Â· @(string.IsNullOrWhiteSpace(Model.Type) ? "-" : Model.Type) Â· @(Model.Year is null ? "-" : Model.Year.Value.ToString())</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/cars">Quay lại danh sách</a>
            <a class="btn btn-outline-secondary" asp-controller="Requests" asp-action="Create" asp-route-carId="@Model.Id" asp-route-type="@CustomerRequestCatalog.ViewCar">Dat lich xem xe</a>
            <a class="btn btn-outline-secondary" asp-controller="Requests" asp-action="Create" asp-route-carId="@Model.Id" asp-route-type="@CustomerRequestCatalog.TestDrive">Lich lai thu</a>
            <a class="btn btn-outline-secondary" asp-controller="Requests" asp-action="Create" asp-route-carId="@Model.Id" asp-route-type="@CustomerRequestCatalog.Deposit">Dat coc truoc</a>
            <button type="button"
                    class="btn btn-primary"
                    data-chatbot-open
                    data-chatbot-prefill="Tôi đang xem xe @Model.BrandName @Model.Name (id @Model.Id). Hãy tư vấn lý do nên chọn xe này và gợi ý 2 mẫu tương tự trong showroom.">
                Hỏi AI tư vấn
            </button>
        </div>
    </div>

    <article class="panel-card">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="car-detail-hero @(Model.ImageUrls.Count == 0 ? "car-thumb-placeholder" : string.Empty)" data-car-hero>
                    @if (Model.ImageUrls.Count == 0)
                    {
                        <div class="car-thumb-placeholder">Chưa có ảnh</div>
                    }
                    else
                    {
                        <img src="@Model.ImageUrls[0]" alt="Ảnh @Model.Name" data-car-hero-img loading="eager" />
                    }
                </div>

                @if (Model.ImageUrls.Count > 1)
                {
                    <div class="car-detail-gallery mt-3" data-car-gallery>
                        @foreach (var url in Model.ImageUrls)
                        {
                            <button type="button" class="car-thumb-button" data-car-thumb="@url" aria-label="Xem ảnh">
                                <img src="@url" alt="Ảnh @Model.Name" loading="lazy" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-5">
                <div class="mb-2">
                    <span class="status-chip @statusClass">@statusLabel</span>
                </div>

                <div class="car-detail-price">@Model.Price.ToString("N0") VND</div>

                <div class="panel-card p-3 mb-3" style="border-radius: 22px;">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Màu</dt>
                        <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.Color) ? Model.Color : "-")</dd>

                        <dt class="col-sm-5">Tồn kho</dt>
                        <dd class="col-sm-7">@Model.StockQuantity</dd>

                        <dt class="col-sm-5">Loại</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Type) ? "-" : Model.Type)</dd>

                        <dt class="col-sm-5">Năm</dt>
                        <dd class="col-sm-7">@((Model.Year is null) ? "-" : Model.Year.Value.ToString())</dd>
                    </dl>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />
                    <h2 class="h5">Mô tả</h2>
                    <p class="mb-0">@Model.Description</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Specifications))
                {
                    <hr />
                    <h2 class="h5">Thông số kỹ thuật</h2>
                    <pre class="spec-block mb-0">@Model.Specifications</pre>
                }
            </div>
        </div>
    </article>
</section>
