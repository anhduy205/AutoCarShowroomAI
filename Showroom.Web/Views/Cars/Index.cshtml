@model IReadOnlyList<Showroom.Web.Models.CarListItemViewModel>

@{
    ViewData["Title"] = "Quản lý xe";
    var statusMessage = TempData["StatusMessage"] as string;
    var statusType = TempData["StatusType"] as string ?? "success";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Kho xe</span>
            <h1 class="dash-title-gradient">Quản lý xe</h1>
            <p class="dash-subtitle">Thêm, cập nhật và theo dõi danh sách xe trong showroom.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-controller="Admin" asp-action="Index">Về bảng điều khiển</a>
            <a class="btn btn-primary btn-dash-action" asp-action="Create">Thêm xe</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-banner dash-status-banner status-@statusType">
            @statusMessage
        </div>
    }

    <article class="panel-card dash-table-panel">
        @if (Model.Count == 0)
        {
            <div class="dash-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <p class="table-note mb-0">Hiện chưa có xe nào trong hệ thống. Hãy thêm mẫu xe đầu tiên để bắt đầu quản lý.</p>
            </div>
        }
        else
        {
            <div class="table-responsive dash-table-wrap">
                <table class="table align-middle dash-table">
                    <thead>
                        <tr>
                            <th><span class="dash-th-label">Tên xe</span></th>
                            <th><span class="dash-th-label">Hãng xe</span></th>
                            <th><span class="dash-th-label">Loại</span></th>
                            <th class="text-end"><span class="dash-th-label">Năm</span></th>
                            <th><span class="dash-th-label">Màu</span></th>
                            <th><span class="dash-th-label">Trạng thái</span></th>
                            <th class="text-end"><span class="dash-th-label">Giá bán</span></th>
                            <th class="text-end"><span class="dash-th-label">Tồn kho</span></th>
                            <th class="text-end"><span class="dash-th-label">Ngày tạo</span></th>
                            <th class="text-end"><span class="dash-th-label">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                CarStatusCatalog.InStock => "status-success",
                                CarStatusCatalog.Promotion => "status-warning",
                                CarStatusCatalog.Sold => "status-danger",
                                _ => "status-warning"
                            };

                            <tr class="dash-table-row">
                                <td><span class="dash-brand-name">@item.Name</span></td>
                                <td>@item.BrandName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Type) ? "-" : item.Type)</td>
                                <td class="text-end">@(item.Year is null ? "-" : item.Year.Value.ToString())</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Color) ? "-" : item.Color)</td>
                                <td><span class="status-chip @statusClass">@item.Status</span></td>
                                <td class="text-end">@item.Price.ToString("N0") VNĐ</td>
                                <td class="text-end"><span class="dash-number-badge">@item.StockQuantity</span></td>
                                <td class="text-end">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="table-actions">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Xem</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-form" onsubmit="return confirm('Bạn có chắc muốn xoá xe này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xoá</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>
