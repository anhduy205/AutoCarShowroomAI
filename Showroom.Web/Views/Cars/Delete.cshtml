@model Showroom.Web.Models.CarDetailsViewModel

@{
    ViewData["Title"] = "Xóa xe";
}

<section class="dashboard-shell">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Xe</span>
            <h1>Xóa xe</h1>
            <p>Vui lòng kiểm tra thông tin xe trước khi xác nhận xóa khỏi danh mục quản lý.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Sửa xe</a>
        </div>
    </div>

    <article class="panel-card">
        <div class="alert alert-warning mb-4" role="alert">
            Thao tác này sẽ xóa xe khỏi hệ thống quản lý. Nếu xe đã phát sinh giao dịch, hệ thống sẽ từ chối xóa để bảo vệ dữ liệu đơn hàng.
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="h4 mb-3">@Model.Name</h2>
                @{
                    var statusClass = Model.Status switch
                    {
                        CarStatusCatalog.InStock => "status-success",
                        CarStatusCatalog.Promotion => "status-warning",
                        CarStatusCatalog.Sold => "status-danger",
                        _ => "status-warning"
                    };
                }
                <div class="mb-3">
                    <span class="status-chip @statusClass">@Model.Status</span>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Hãng xe</dt>
                    <dd class="col-sm-8">@Model.BrandName</dd>

                    <dt class="col-sm-4">Loại</dt>
                    <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Type) ? Model.Type : "-")</dd>

                    <dt class="col-sm-4">Năm</dt>
                    <dd class="col-sm-8">@(Model.Year is null ? "-" : Model.Year.Value.ToString())</dd>

                    <dt class="col-sm-4">Màu</dt>
                    <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Color) ? Model.Color : "-")</dd>

                    <dt class="col-sm-4">Giá bán</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("N0") VNĐ</dd>

                    <dt class="col-sm-4">Tồn kho</dt>
                    <dd class="col-sm-8">@Model.StockQuantity</dd>

                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>

            <div class="col-lg-4">
                @if (Model.ImageUrls.Count > 0)
                {
                    <img src="@Model.ImageUrls[0]" alt="Ảnh @Model.Name" class="img-fluid rounded mb-3" />
                }
                else
                {
                    <p class="text-muted mb-3">Xe này chưa có ảnh đại diện.</p>
                }
            </div>
        </div>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="page-actions mt-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </form>
    </article>
</section>
