@model Showroom.Web.Models.CarDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết xe";
}

<section class="dashboard-shell dashboard-premium">
    <div class="page-heading dash-heading-animated">
        <div>
            <span class="eyebrow eyebrow-glow">Xe</span>
            <h1 class="dash-title-gradient">Chi tiết xe</h1>
            <p class="dash-subtitle">Xem thông tin chi tiết và ảnh minh hoạ (nếu có).</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-dash-action" asp-action="Index">Quay lại</a>
            <a class="btn btn-primary btn-dash-action" asp-action="Edit" asp-route-id="@Model.Id">Sửa xe</a>
        </div>
    </div>

    <article class="panel-card dash-table-panel">
        <div class="row g-4">
            <div class="col-lg-7">
                <h2 class="h4 mb-3 dash-brand-name">@Model.Name</h2>
                @{
                    var statusClass = Model.Status switch
                    {
                        CarStatusCatalog.InStock => "status-success",
                        CarStatusCatalog.Promotion => "status-warning",
                        CarStatusCatalog.Sold => "status-danger",
                        _ => "status-warning"
                    };
                }
                <div class="mb-3">
                    <span class="status-chip @statusClass">@Model.Status</span>
                </div>
                <div class="detail-spec-card p-3 mb-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Hãng</dt>
                        <dd class="col-sm-8">@Model.BrandName</dd>
                        <dt class="col-sm-4">Loại</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Type) ? Model.Type : "-")</dd>
                        <dt class="col-sm-4">Năm</dt>
                        <dd class="col-sm-8">@(Model.Year is null ? "-" : Model.Year.Value.ToString())</dd>
                        <dt class="col-sm-4">Màu</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Color) ? Model.Color : "-")</dd>
                        <dt class="col-sm-4">Giá</dt>
                        <dd class="col-sm-8"><span class="dash-brand-name" style="color:var(--primary)">@Model.Price.ToString("N0") VNĐ</span></dd>
                        <dt class="col-sm-4">Tồn kho</dt>
                        <dd class="col-sm-8"><span class="dash-number-badge">@Model.StockQuantity</span></dd>
                        <dt class="col-sm-4">Ngày tạo</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />
                    <h3 class="h5">Mô tả</h3>
                    <p class="mb-0">@Model.Description</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Specifications))
                {
                    <hr />
                    <h3 class="h5">Thông số kỹ thuật</h3>
                    <pre class="spec-block mb-0">@Model.Specifications</pre>
                }
            </div>

            <div class="col-lg-5">
                <h3 class="h5">Ảnh</h3>
                @if (Model.ImageUrls.Count == 0)
                {
                    <div class="dash-empty-state">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--line-strong)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        <p class="text-muted mb-0">Chưa có ảnh cho xe này.</p>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var url in Model.ImageUrls)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <img src="@url" alt="Ảnh @Model.Name" class="img-fluid rounded" style="border-radius:16px !important;" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </article>
</section>
